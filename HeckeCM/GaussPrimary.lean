import HeckeCM.GaussInt
import HeckeCM.GaussPlaces
import HeckeCM.Sequence

/-!
# Primary generators of the odd places of `ℚ(i)`

An element `a + b i` is *primary* if `(a, b)` is a primary pair
(`IsPrimaryPair`), i.e. `a + b i ≡ 1 (mod (1 + i)³)`.

* `exists_primary_generator`: every place not containing 2 has a primary
  generator;
* `primary_unique`: the primary generator of an ideal is unique;
* `exists_primary_split`: for `p ≡ 1 (mod 4)` the two places above `p` are
  generated by `a + b i` and `a − b i`, with `a² + b² = p` and `(a, b)` primary;
* `exists_primary_inert`: for `p ≡ 3 (mod 4)` the place above `p` has primary
  generator `−p`.
-/

open NumberField IsDedekindDomain Ideal

namespace CMPoints

variable (K : Type) [Field K] [NumberField K] [IsCyclotomicExtension {4} ℚ K]

/-- The element `a + b i` of `𝓞 K`. -/
noncomputable abbrev gaussOf (a b : ℤ) : 𝓞 K := (a : 𝓞 K) + (b : 𝓞 K) * gaussI K

variable {K}

lemma isUnit_gaussI : IsUnit (gaussI K) :=
  isUnit_iff_exists_inv.2 ⟨-gaussI K, by linear_combination -(gaussI_sq K)⟩

lemma gaussI_mul_gaussOf (a b : ℤ) : gaussI K * gaussOf K a b = gaussOf K (-b) a := by
  unfold gaussOf
  push_cast
  linear_combination (b : 𝓞 K) * gaussI_sq K

lemma span_gaussOf_neg (a b : ℤ) : span {gaussOf K (-a) (-b)} = span {gaussOf K a b} := by
  rw [← Ideal.span_singleton_neg (gaussOf K a b)]
  congr 2
  unfold gaussOf
  push_cast
  ring

lemma span_gaussOf_rot (a b : ℤ) : span {gaussOf K (-b) a} = span {gaussOf K a b} := by
  rw [← gaussI_mul_gaussOf, Ideal.span_singleton_mul_left_unit isUnit_gaussI]

lemma sq_add_sq_eq_of_absNorm {a b : ℤ} {n : ℕ} (h : absNorm (span {gaussOf K a b}) = n) :
    a ^ 2 + b ^ 2 = n := by
  unfold gaussOf at h
  rw [absNorm_span_coords] at h
  rw [← h, Int.natAbs_of_nonneg (by positivity)]

/-- Every `a + b i` with `a + b` odd is associate to a primary element. -/
theorem exists_primary_assoc (a b : ℤ) (hodd : (a + b) % 2 = 1) :
    ∃ c d : ℤ, IsPrimaryPair c d ∧ span {gaussOf K c d} = span {gaussOf K a b} := by
  have hcases : IsPrimaryPair a b ∨ IsPrimaryPair (-a) (-b) ∨ IsPrimaryPair (-b) a ∨
      IsPrimaryPair b (-a) := by
    unfold IsPrimaryPair
    omega
  rcases hcases with h | h | h | h
  · exact ⟨a, b, h, rfl⟩
  · exact ⟨-a, -b, h, span_gaussOf_neg a b⟩
  · exact ⟨-b, a, h, span_gaussOf_rot a b⟩
  · refine ⟨b, -a, h, ?_⟩
    have := span_gaussOf_neg (K := K) (-b) a
    rw [neg_neg] at this
    rw [this, span_gaussOf_rot]

/-- **The primary generator of an ideal is unique.** -/
theorem primary_unique {a b c d : ℤ} (h1 : IsPrimaryPair a b) (h2 : IsPrimaryPair c d)
    (h : span {gaussOf K a b} = span {gaussOf K c d}) : a = c ∧ b = d := by
  rw [Ideal.span_singleton_eq_span_singleton] at h
  obtain ⟨u, hu⟩ := h
  obtain ⟨e, f, hef⟩ := exists_coords (u : 𝓞 K)
  have hunit : e ^ 2 + f ^ 2 = 1 := (isUnit_coords_iff e f).1 (hef ▸ u.isUnit)
  have hcoord := coords_unique (K := K) (a := a * e - b * f) (b := a * f + b * e) (c := c) (d := d)
    (by
      have hu' : gaussOf K c d = gaussOf K a b * ((e : 𝓞 K) + (f : 𝓞 K) * gaussI K) := by
        rw [← hu, hef]
      unfold gaussOf at hu'
      rw [hu']
      push_cast
      linear_combination (-((b : 𝓞 K) * f)) * gaussI_sq K)
  obtain ⟨hc1, hc2⟩ := hcoord
  have he1 : e ≤ 1 := by nlinarith [sq_nonneg f]
  have he2 : -1 ≤ e := by nlinarith [sq_nonneg f]
  have hf1 : f ≤ 1 := by nlinarith [sq_nonneg e]
  have hf2 : -1 ≤ f := by nlinarith [sq_nonneg e]
  unfold IsPrimaryPair at h1 h2
  interval_cases e <;> interval_cases f <;> omega

lemma two_not_mem (v : HeightOneSpectrum (𝓞 K)) {p : ℕ} (hodd : p % 2 = 1)
    (hp : ((p : ℕ) : 𝓞 K) ∈ v.asIdeal) : (2 : 𝓞 K) ∉ v.asIdeal := by
  intro h2
  obtain ⟨k, hk⟩ : ∃ k, p = 2 * k + 1 := ⟨p / 2, by omega⟩
  have h1 : (1 : 𝓞 K) ∈ v.asIdeal := by
    have h := v.asIdeal.sub_mem hp (v.asIdeal.mul_mem_left (k : 𝓞 K) h2)
    have e : ((p : ℕ) : 𝓞 K) - (k : 𝓞 K) * 2 = 1 := by rw [hk]; push_cast; ring
    rwa [e] at h
  exact v.isPrime.ne_top ((Ideal.eq_top_iff_one _).2 h1)

/-- **Every place not containing 2 has a primary generator.** -/
theorem exists_primary_generator (v : HeightOneSpectrum (𝓞 K)) (h2 : (2 : 𝓞 K) ∉ v.asIdeal) :
    ∃ a b : ℤ, IsPrimaryPair a b ∧ v.asIdeal = span {gaussOf K a b} := by
  obtain ⟨x, hx⟩ := (isPrincipalIdealRing_gauss K).principal v.asIdeal
  obtain ⟨a, b, rfl⟩ := exists_coords x
  have hx' : v.asIdeal = span {gaussOf K a b} := hx
  have hodd : (a + b) % 2 = 1 := by
    by_contra hne
    apply h2
    obtain ⟨m, hm⟩ : ∃ m, a + b = 2 * m := ⟨(a + b) / 2, by omega⟩
    have hfac : gaussOf K a b = (1 + gaussI K) * gaussOf K m (b - m) := by
      have ha : a = 2 * m - b := by omega
      subst ha
      unfold gaussOf
      push_cast
      linear_combination ((m : 𝓞 K) - b) * gaussI_sq K
    have hle : v.asIdeal ≤ span {1 + gaussI K} := by
      rw [hx', Ideal.span_singleton_le_span_singleton]
      exact ⟨_, hfac⟩
    have hne_top : span {1 + gaussI K} ≠ ⊤ := by
      rw [Ne, Ideal.span_singleton_eq_top]
      intro hu
      have := (isUnit_coords_iff (K := K) 1 1).1 (by simpa using hu)
      norm_num at this
    have heq := v.isMaximal.eq_of_le hne_top hle
    rw [heq, Ideal.mem_span_singleton]
    exact ⟨1 - gaussI K, by linear_combination gaussI_sq K⟩
  obtain ⟨c, d, hcd, hspan⟩ := exists_primary_assoc (K := K) a b hodd
  exact ⟨c, d, hcd, hx'.trans hspan.symm⟩

/-- **The place above 2** is generated by `1 + i`. -/
theorem asIdeal_eq_span_one_add_gaussI (v : HeightOneSpectrum (𝓞 K))
    (h2 : (2 : 𝓞 K) ∈ v.asIdeal) : v.asIdeal = span {1 + gaussI K} := by
  have hmem : 1 + gaussI K ∈ v.asIdeal := by
    have hfac : (2 : 𝓞 K) = (1 + gaussI K) * (1 - gaussI K) := by linear_combination gaussI_sq K
    rw [hfac] at h2
    rcases v.isPrime.mem_or_mem h2 with h | h
    · exact h
    · have : 1 + gaussI K = gaussI K * (1 - gaussI K) := by linear_combination gaussI_sq K
      rw [this]
      exact v.asIdeal.mul_mem_left _ h
  have hN : absNorm (span {1 + gaussI K}) = 2 := by
    have := absNorm_span_coords (K := K) 1 1
    simpa using this
  have hprime : (span {1 + gaussI K}).IsPrime :=
    Ideal.isPrime_of_irreducible_absNorm (by rw [hN]; exact Nat.prime_two)
  have hbot : span {1 + gaussI K} ≠ ⊥ := by
    intro h0
    rw [h0, Ideal.absNorm_bot] at hN
    exact absurd hN (by norm_num)
  exact ((hprime.isMaximal hbot).eq_of_le v.isPrime.ne_top
    ((Ideal.span_singleton_le_iff_mem _).2 hmem)).symm

/-- **`p ≡ 1 (mod 4)`**: the two places above `p` are generated by `a + b i` and
`a − b i`, with `(a, b)` primary and `a² + b² = p`. -/
theorem exists_primary_split (p : ℕ) [hp : Fact p.Prime] (h : p % 4 = 1) :
    ∃ (v w : HeightOneSpectrum (𝓞 K)) (a b : ℤ), v ≠ w ∧
      (∀ u : HeightOneSpectrum (𝓞 K), ((p : ℕ) : 𝓞 K) ∈ u.asIdeal ↔ u = v ∨ u = w) ∧
      absNorm v.asIdeal = p ∧ absNorm w.asIdeal = p ∧
      IsPrimaryPair a b ∧ IsPrimaryPair a (-b) ∧ a ^ 2 + b ^ 2 = p ∧
      v.asIdeal = span {gaussOf K a b} ∧ w.asIdeal = span {gaussOf K a (-b)} := by
  obtain ⟨v, w, hvw, hmem, hNv, hNw⟩ := exists_two_places_of_mod_four_eq_one (K := K) p h
  have hodd : p % 2 = 1 := by omega
  obtain ⟨a, b, hab, hva⟩ := exists_primary_generator v (two_not_mem v hodd ((hmem v).2 (Or.inl rfl)))
  obtain ⟨c, d, hcd, hwc⟩ := exists_primary_generator w (two_not_mem w hodd ((hmem w).2 (Or.inr rfl)))
  have hn1 : a ^ 2 + b ^ 2 = p := sq_add_sq_eq_of_absNorm (hva ▸ hNv)
  have hn2 : c ^ 2 + d ^ 2 = p := sq_add_sq_eq_of_absNorm (hwc ▸ hNw)
  have hac : a = c := (cmA_eq hp.out hn1 hab).symm.trans (cmA_eq hp.out hn2 hcd)
  subst hac
  have hd : d = b ∨ d = -b := sq_eq_sq_iff_eq_or_eq_neg.1 (by linarith)
  rcases hd with rfl | rfl
  · exact absurd (HeightOneSpectrum.ext (hva.trans hwc.symm)) hvw
  · exact ⟨v, w, a, b, hvw, hmem, hNv, hNw, hab, hcd, hn1, hva, hwc⟩

/-- **`p ≡ 3 (mod 4)`**: the place above `p` has primary generator `−p`. -/
theorem exists_primary_inert (p : ℕ) [hp : Fact p.Prime] (h : p % 4 = 3) :
    ∃ v : HeightOneSpectrum (𝓞 K),
      (∀ u : HeightOneSpectrum (𝓞 K), ((p : ℕ) : 𝓞 K) ∈ u.asIdeal ↔ u = v) ∧
      absNorm v.asIdeal = p ^ 2 ∧ IsPrimaryPair (-(p : ℤ)) 0 ∧
      v.asIdeal = span {gaussOf K (-(p : ℤ)) 0} := by
  obtain ⟨v, hmem, hN⟩ := exists_unique_place_of_mod_four_eq_three (K := K) p h
  refine ⟨v, hmem, hN, by unfold IsPrimaryPair; omega, ?_⟩
  have hpv : ((p : ℕ) : 𝓞 K) ∈ v.asIdeal := (hmem v).2 rfl
  obtain ⟨a, b, -, hva⟩ := exists_primary_generator v (two_not_mem v (by omega) hpv)
  have hn : a ^ 2 + b ^ 2 = ((p ^ 2 : ℕ) : ℤ) := sq_add_sq_eq_of_absNorm (hva ▸ hN)
  rw [hva, Ideal.mem_span_singleton] at hpv
  obtain ⟨y, hy⟩ := hpv
  obtain ⟨e, f, rfl⟩ := exists_coords y
  have hnorm : absNorm (span {(((p : ℕ) : ℤ) : 𝓞 K)}) =
      absNorm (span {gaussOf K a b}) * absNorm (span {gaussOf K e f}) := by
    rw [← map_mul, Ideal.span_singleton_mul_span_singleton, Int.cast_natCast, hy]
  unfold gaussOf at hnorm
  rw [absNorm_span_intCast, absNorm_span_coords, absNorm_span_coords, hn, Int.natAbs_natCast,
    Int.natAbs_natCast] at hnorm
  have hN1 : (e ^ 2 + f ^ 2).natAbs = 1 :=
    Nat.eq_of_mul_eq_mul_left (pow_pos hp.out.pos 2) (by rw [mul_one]; exact hnorm.symm)
  have hunit : IsUnit (gaussOf K e f) := by
    refine (isUnit_coords_iff e f).2 ?_
    have := Int.natAbs_of_nonneg (show 0 ≤ e ^ 2 + f ^ 2 by positivity)
    rw [hN1] at this
    exact_mod_cast this.symm
  have hneg : gaussOf K (-(p : ℤ)) 0 = -((p : ℕ) : 𝓞 K) := by simp [gaussOf]
  rw [hva, hneg, Ideal.span_singleton_neg, hy]
  exact (Ideal.span_singleton_mul_right_unit hunit (gaussOf K a b)).symm

end CMPoints
