import HeckeCM.CurveModel
import HeckeCM.CurveCharSum

/-!
# The points of `y² = x³ - x` over a finite field

Let `F` be a finite field with `q` elements, of characteristic different from 2, and
`a_q = q + 1 - #E(F)` the Frobenius trace of `E : y² = x³ - x`
(`WeierstrassCurve.frobeniusTrace` from Tau Ceti).

* `frobeniusTrace_curve`: `a_q = -∑ x, η (x ^ 3 - x)`, with `η` the quadratic
  character.
* `frobeniusTrace_curve_eq_zero`: if `q ≡ 3 (mod 4)` then `a_q = 0`.
* `frobeniusTrace_curve_eq_jacobiSum`: if `χ` is a character of order 4,
  `a_q = -χ (-1) * (J(χ, χ) + J(χ⁻¹, χ⁻¹))`.
* `frobeniusTrace_curve_gaussian`: over the residue field of `ℤ[i]` at a prime
  generated by a primary element `π`, `a_q = π + π̄`.
-/

open Finset CMPoints NumberField

namespace CMPoints

section Generale

variable {F : Type*} [Field F] [Fintype F] [DecidableEq F]

/-- The number of affine solutions of `y² = x³ - x`. -/
lemma card_affine (hF : ringChar F ≠ 2) :
    (Nat.card {p : F × F // (CurveX3SubX.curve F).toAffine.Equation p.1 p.2} : ℤ) =
      Fintype.card F + ∑ x : F, quadraticChar F (x ^ 3 - x) := by
  have hiff : ∀ p : F × F, (CurveX3SubX.curve F).toAffine.Equation p.1 p.2 ↔
      p.2 ^ 2 = p.1 ^ 3 - p.1 := by
    intro p
    rw [WeierstrassCurve.Affine.equation_iff]
    simp only [CurveX3SubX.curve]
    constructor <;> intro h <;> linear_combination h
  rw [Nat.card_congr (Equiv.subtypeEquivRight hiff), Nat.card_eq_fintype_card,
    Fintype.card_congr (Equiv.subtypeProdEquivSigmaSubtype fun x y : F => y ^ 2 = x ^ 3 - x),
    Fintype.card_sigma]
  push_cast
  rw [Finset.sum_congr rfl fun x _ => by
    rw [Fintype.card_subtype, card_filter_sq hF (x ^ 3 - x)], Finset.sum_add_distrib]
  simp
  ring

/-- **The Frobenius trace of `y² = x³ - x`** as a character sum. -/
theorem frobeniusTrace_curve (hF : ringChar F ≠ 2) :
    (CurveX3SubX.curve F).frobeniusTrace = -∑ x : F, quadraticChar F (x ^ 3 - x) := by
  rw [WeierstrassCurve.frobeniusTrace_def, WeierstrassCurve.pointCount_def, Nat.card_eq_fintype_card]
  have := card_affine hF
  push_cast
  rw [this]
  ring

/-- **If `q ≡ 3 (mod 4)`, the curve `y² = x³ - x` has `q + 1` points.** -/
theorem frobeniusTrace_curve_eq_zero (h : Fintype.card F % 4 = 3) :
    (CurveX3SubX.curve F).frobeniusTrace = 0 := by
  have hF : ringChar F ≠ 2 := by
    intro h2
    have := FiniteField.even_card_iff_char_two.1 h2
    omega
  rw [frobeniusTrace_curve hF, sum_quadraticChar_cubic_eq_zero, neg_zero]
  rw [quadraticChar_neg_one hF, ZMod.χ₄_nat_three_mod_four h]

/-- **The Frobenius trace of `y² = x³ - x` in terms of a quartic Jacobi sum.** -/
theorem frobeniusTrace_curve_eq_jacobiSum {R : Type*} [CommRing R] [IsDomain R] {χ : MulChar F R}
    (hχ : orderOf χ = 4) :
    (((CurveX3SubX.curve F).frobeniusTrace : ℤ) : R) =
      -χ (-1) * (jacobiSum χ χ + jacobiSum χ⁻¹ χ⁻¹) := by
  have hdvd : 4 ∣ Fintype.card F - 1 := hχ ▸ χ.orderOf_dvd_card_sub_one
  have hcard : 1 ≤ Fintype.card F := Fintype.card_pos
  have hF : ringChar F ≠ 2 := by
    intro h2
    have := FiniteField.even_card_iff_char_two.1 h2
    omega
  have hm1 : IsSquare (-1 : F) := by
    rw [FiniteField.isSquare_neg_one_iff]
    omega
  rw [frobeniusTrace_curve hF, Int.cast_neg, sum_quadraticChar_cubic_eq_jacobiSum hF hχ hm1]
  ring

end Generale

end CMPoints
