import HeckeCM.GaussPrimary

/-!
# The place of `ℚ(i)` above 2 and the classes modulo `2 + 2i`

* `placeTwo`: the place generated by `1 + i`, the only one containing 2;
* `span_two_add_two`: `(2 + 2i) = (1 + i)³`;
* `exists_unit_dvd_sub`: every element not divisible by `1 + i` is congruent to
  a unit modulo `2 + 2i`;
* `unit_eq_of_dvd_sub`: two units congruent modulo `2 + 2i` coincide.

Together they say that the units `±1, ±i` form a system of representatives of
`(𝓞 K / (1 + i)³)ˣ`: this is what is needed to define the character at 2.
-/

open NumberField IsDedekindDomain Ideal

namespace CMPoints

variable {K : Type} [Field K] [NumberField K] [IsCyclotomicExtension {4} ℚ K]

lemma absNorm_span_one_add_gaussI : absNorm (span {1 + gaussI K}) = 2 := by
  have := absNorm_span_coords (K := K) 1 1
  simpa using this

lemma isPrime_span_one_add_gaussI : (span {1 + gaussI K}).IsPrime :=
  Ideal.isPrime_of_irreducible_absNorm (by rw [absNorm_span_one_add_gaussI]; exact Nat.prime_two)

lemma span_one_add_gaussI_ne_bot : span {1 + gaussI K} ≠ ⊥ := by
  intro h0
  have hN := absNorm_span_one_add_gaussI (K := K)
  rw [h0, Ideal.absNorm_bot] at hN
  exact absurd hN (by norm_num)

variable (K) in
/-- The place of `K` above 2. -/
def placeTwo : HeightOneSpectrum (𝓞 K) :=
  ⟨span {1 + gaussI K}, isPrime_span_one_add_gaussI, span_one_add_gaussI_ne_bot⟩

lemma placeTwo_asIdeal : (placeTwo K).asIdeal = span {1 + gaussI K} := rfl

lemma two_mem_placeTwo : (2 : 𝓞 K) ∈ (placeTwo K).asIdeal := by
  rw [placeTwo_asIdeal, Ideal.mem_span_singleton]
  exact ⟨1 - gaussI K, by linear_combination gaussI_sq K⟩

theorem eq_placeTwo_of_two_mem {v : HeightOneSpectrum (𝓞 K)} (h : (2 : 𝓞 K) ∈ v.asIdeal) :
    v = placeTwo K :=
  HeightOneSpectrum.ext (asIdeal_eq_span_one_add_gaussI v h)

theorem two_mem_iff_eq_placeTwo {v : HeightOneSpectrum (𝓞 K)} :
    (2 : 𝓞 K) ∈ v.asIdeal ↔ v = placeTwo K :=
  ⟨eq_placeTwo_of_two_mem, fun h => h ▸ two_mem_placeTwo⟩

/-- `(2 + 2i) = (1 + i)³`. -/
theorem span_two_add_two : span {gaussOf K 2 2} = (placeTwo K).asIdeal ^ 3 := by
  have h : gaussOf K 2 2 = -gaussI K * (1 + gaussI K) ^ 3 := by
    unfold gaussOf
    push_cast
    linear_combination (gaussI K ^ 2 + 3 * gaussI K + 2) * gaussI_sq K
  rw [placeTwo_asIdeal, Ideal.span_singleton_pow, h,
    Ideal.span_singleton_mul_left_unit isUnit_gaussI.neg]

lemma one_add_gaussI_dvd_of_even {a b : ℤ} (h : (a + b) % 2 = 0) :
    (1 + gaussI K) ∣ gaussOf K a b := by
  obtain ⟨m, hm⟩ : ∃ m, a + b = 2 * m := ⟨(a + b) / 2, by omega⟩
  refine ⟨gaussOf K m (b - m), ?_⟩
  have ha : a = 2 * m - b := by omega
  subst ha
  unfold gaussOf
  push_cast
  linear_combination ((m : 𝓞 K) - b) * gaussI_sq K

lemma two_add_two_dvd_of_isPrimaryPair {c d : ℤ} (h : IsPrimaryPair c d) :
    gaussOf K 2 2 ∣ gaussOf K c d - 1 := by
  unfold IsPrimaryPair at h
  obtain ⟨m, hm⟩ : ∃ m, c - 1 + d = 4 * m := ⟨(c - 1 + d) / 4, by omega⟩
  obtain ⟨n, hn⟩ : ∃ n, d - c + 1 = 4 * n := ⟨(d - c + 1) / 4, by omega⟩
  refine ⟨gaussOf K m n, ?_⟩
  have hc : c = 1 + 2 * m - 2 * n := by omega
  have hd : d = 2 * m + 2 * n := by omega
  subst hc hd
  unfold gaussOf
  push_cast
  linear_combination (-2 * (n : 𝓞 K)) * gaussI_sq K

/-- **Every element coprime to `1 + i` is congruent to a unit modulo `2 + 2i`.** -/
theorem exists_unit_dvd_sub (x : 𝓞 K) (hx : ¬ (1 + gaussI K) ∣ x) :
    ∃ u : (𝓞 K)ˣ, gaussOf K 2 2 ∣ x - u := by
  obtain ⟨a, b, rfl⟩ := exists_coords x
  have hodd : (a + b) % 2 = 1 := by
    by_contra h
    exact hx (one_add_gaussI_dvd_of_even (by omega))
  obtain ⟨c, d, hcd, hspan⟩ := exists_primary_assoc (K := K) a b hodd
  rw [Ideal.span_singleton_eq_span_singleton] at hspan
  obtain ⟨u, hu⟩ := hspan
  obtain ⟨q, hq⟩ := two_add_two_dvd_of_isPrimaryPair (K := K) hcd
  exact ⟨u, q * u, by linear_combination (u : 𝓞 K) * hq - hu⟩

/-- **Two units congruent modulo `2 + 2i` coincide.** -/
theorem unit_eq_of_dvd_sub (u u' : (𝓞 K)ˣ) (h : gaussOf K 2 2 ∣ (u : 𝓞 K) - u') : u = u' := by
  obtain ⟨e, f, hef⟩ := exists_coords (u : 𝓞 K)
  obtain ⟨e', f', hef'⟩ := exists_coords (u' : 𝓞 K)
  have h1 : e ^ 2 + f ^ 2 = 1 := (isUnit_coords_iff e f).1 (hef ▸ u.isUnit)
  have h2 : e' ^ 2 + f' ^ 2 = 1 := (isUnit_coords_iff e' f').1 (hef' ▸ u'.isUnit)
  have hsub : (u : 𝓞 K) - u' = gaussOf K (e - e') (f - f') := by
    rw [hef, hef']
    unfold gaussOf
    push_cast
    ring
  rw [hsub] at h
  have hdvd := Ideal.absNorm_dvd_absNorm_of_le (Ideal.span_singleton_le_span_singleton.2 h)
  unfold gaussOf at hdvd
  rw [absNorm_span_coords, absNorm_span_coords, Int.natAbs_dvd_natAbs] at hdvd
  have hd8 : (8 : ℤ) ∣ (e - e') ^ 2 + (f - f') ^ 2 := by
    norm_num at hdvd
    exact hdvd
  have key : e = e' ∧ f = f' := by
    have b1 : e ≤ 1 := by nlinarith [sq_nonneg f]
    have b2 : -1 ≤ e := by nlinarith [sq_nonneg f]
    have b3 : f ≤ 1 := by nlinarith [sq_nonneg e]
    have b4 : -1 ≤ f := by nlinarith [sq_nonneg e]
    have b5 : e' ≤ 1 := by nlinarith [sq_nonneg f']
    have b6 : -1 ≤ e' := by nlinarith [sq_nonneg f']
    have b7 : f' ≤ 1 := by nlinarith [sq_nonneg e']
    have b8 : -1 ≤ f' := by nlinarith [sq_nonneg e']
    clear hef hef' hsub h hdvd
    interval_cases e <;> interval_cases f <;> interval_cases e' <;> interval_cases f' <;> omega
  refine Units.ext ?_
  rw [hef, hef', key.1, key.2]

end CMPoints
